# Copia in .env per `npm run dev` contro gli emulatori Firebase (npm run emulators).
PUBLIC_SITE_URL=http://localhost:5173
PUBLIC_FIREBASE_API_KEY=demo-key
PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
PUBLIC_FIREBASE_PROJECT_ID=demo-eventi
PUBLIC_FIREBASE_APP_ID=demo-app
PUBLIC_USE_EMULATORS=true
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
CONTACT_EMAIL=privacy@example.org
