{
  "name": "eventi-vicini-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "npm run build && wrangler pages dev .svelte-kit/cloudflare --port 8788",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:reads": "node ../firebase/node_modules/firebase-tools/lib/bin/firebase.js emulators:exec --config ../firebase/firebase.json --project demo-eventi --only firestore \"vitest run src/lib/server/reads.emulator.test.ts --reporter verbose\"",
    "test:e2e": "node ../firebase/node_modules/firebase-tools/lib/bin/firebase.js emulators:exec --config ../firebase/firebase.json --project demo-eventi --only auth,firestore \"playwright test\"",
    "emulators": "node ../firebase/node_modules/firebase-tools/lib/bin/firebase.js emulators:start --config ../firebase/firebase.json --project demo-eventi --only auth,firestore",
    "seed": "node scripts/seed-emulator.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-cloudflare": "7.2.9",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/leaflet": "1.9.22",
    "eslint": "9.39.5",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "wrangler": "4.153.0"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "firebase": "12.19.0",
    "geofire-common": "6.0.0",
    "leaflet": "1.9.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true,
    "@firebase/util": false,
    "protobufjs": false
  }
}
